# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# When set, GA4 is loaded and page views + conversion events are sent.
# Add the same variable in the Vercel project settings to enable it in production.
NEXT_PUBLIC_GA_ID=

# Resend API key used by the contact form (/api/contact).
RESEND_API_KEY=

# Optional: override the contact form sender and recipient.
# The sender domain must be verified in Resend for production delivery.
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
CONTACT_TO_EMAIL=

# ---------------------------------------------------------------------------
# Private visit analytics (/admin)
# ---------------------------------------------------------------------------
# Free Upstash Redis database: console.upstash.com -> Redis -> REST API.
# Vercel Marketplace Redis exposes the same values as KV_REST_API_URL/TOKEN,
# and both naming schemes are supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Password for /admin. Leave empty to disable the dashboard entirely.
ADMIN_PASSWORD=

# Optional: secret used to sign the admin session cookie (falls back to ADMIN_PASSWORD).
ADMIN_SESSION_SECRET=

# Optional: salt used when hashing fallback visitor IDs (change it any time to reset uniqueness).
ANALYTICS_SALT=

# Optional: timezone used to group visits into days (default Africa/Lagos).
ANALYTICS_TIMEZONE=Africa/Lagos

# Optional: comma-separated hostnames to exclude from analytics, e.g. staging.example.com.
ANALYTICS_EXCLUDE_HOSTS=

# Optional: set to 1 to allow tracking on localhost (off by default so dev traffic is excluded).
ANALYTICS_ALLOW_LOCAL=

# Optional: set to false to disable IP geolocation entirely.
GEOLOCATION_ENABLED=true

# Optional: geolocation endpoint (default https://ipwho.is). Raw IPs are never stored.
GEOLOCATION_API_URL=
