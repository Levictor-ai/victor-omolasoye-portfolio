# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# When set, GA4 is loaded and page views + conversion events are sent.
# Add the same variable in the Vercel project settings to enable it in production.
NEXT_PUBLIC_GA_ID=

# Resend API key used by the contact form (/api/contact).
RESEND_API_KEY=

# Optional: override the contact form sender and recipient.
# The sender domain must be verified in Resend for production delivery.
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
CONTACT_TO_EMAIL=
